        //     return
        // }

        // var tweenDuration int = duration / (increaseTo - lastContentInt)
        // while lastContentInt < increaseTo {
        //     lastContentInt = lastContentInt + 1
        //     widget<UIWidgetLabel>.Content = ToString(lastContentInt)
        //     WaitForMillisecond(tweenDuration)
        // }
        widget<UIWidgetLabel>.Content = ToString(increaseTo)
    }
}