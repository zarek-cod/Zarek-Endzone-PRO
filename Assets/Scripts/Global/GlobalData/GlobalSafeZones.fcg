        safeZoneInitRadius[6] = 60.0
        safeZoneInitRadius[7] = 55.0
        safeZoneInitRadius[8] = 48.0
        safeZoneInitRadius[9] = 48.0
        safeZoneInitRadius[10] = 52.0
        safeZonesEndRadius[0] = 28.0
        safeZonesEndRadius[1] = 29.0
        safeZonesEndRadius[2] = 33.0
        safeZonesEndRadius[3] = 32.0
        safeZonesEndRadius[4] = 31.0
        safeZonesEndRadius[5] = 32.0
        safeZonesEndRadius[6] = 33.0
        safeZonesEndRadius[7] = 31.0
        safeZonesEndRadius[8] = 28.0
        safeZonesEndRadius[9] = 28.0
        safeZonesEndRadius[10] = 30.0
        SetStartShrinkTime(globalEntity<GlobalGameManager>.prepPhaseDuration)
