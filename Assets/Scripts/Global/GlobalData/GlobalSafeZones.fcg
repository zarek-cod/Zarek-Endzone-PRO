    /*
    Activate a specific safe zone
    @param index The index of the safe zone to activate, which goes with the respective spawn point id
    */
    async func ActivateSafeZone(index int, phase entity<Phase>){
        if !Map.ContainKey(safeZoneStartPoints, index) || !Map.ContainKey(safeZoneInitRadius, index) || !Map.ContainKey(safeZonesEndRadius, index) || !Map.ContainKey(safeZonesShrinkDuration, index) {
            LogError("<GlobalSafeZones.fcg>: Missing safe-zone data for stage " + index)
            return
        }
        if phase<Phase>.Index == EPhase.__Before6Combat__ {
            LogWarning("Safe Zone activated for index: " + index)
            DisableSafeZone()
            EnableSafeZone(safeZoneStartPoints[index], safeZoneInitRadius[index], safeZoneStartShrinkTimes[index], safeZonesShrinkDuration[index], safeZonePrepPhaseDmg)
            LogWarning("Safe Zone starts to shrink in " + safeZoneStartShrinkTimes[index] + "secs")
        } else if phase<Phase>.Index == EPhase.Combat {
            DisableSafeZone()
            EnableMovingSafeZone(safeZoneStartPoints[index], safeZoneStartPoints[index], safeZoneInitRadius[index], safeZonesEndRadius[index], safeZonesShrinkDuration[index], safeZonePhase1Dmg)
            globalEntity<GlobalUIManager>.ActivateBorderShrinkingNotification()
            LogWarning("Safe Zone phase 1: " + safeZoneStartPoints[index] + " to " + safeZoneStartPoints[index] + " with radius from " + safeZoneInitRadius[index] + " to " + safeZonesEndRadius[index] + " in duration " + safeZonesShrinkDuration[index])
        } else if phase<Phase>.Index == EPhase.MovingSafeZone {
            if !Map.ContainKey(safeZoneEndPoints, index) || safeZoneEndPoints[index] == nil || List.Length(safeZoneEndPoints[index]) == 0 {
                LogError("<GlobalSafeZones.fcg>: Stage " + index + " has no moving-zone endpoints")
                return
            }
            var randomMovingPoint = RandomInt(0, List.Length(safeZoneEndPoints[index]))
            var endPointPosition = safeZoneEndPoints[index][randomMovingPoint] as entity<Transform>
            if endPointPosition == nil {
                LogError("<GlobalSafeZones.fcg>: Invalid moving-zone endpoint for stage " + index)
                return
            }
            currentEndPoint = endPointPosition
            DisableSafeZone()
            EnableMovingSafeZone(safeZoneStartPoints[index], endPointPosition<Transform>.Position, safeZonesEndRadius[index], safeZonesEndRadius[index] - reduceRadiusWhenMoving, safeZonesShrinkDuration[index], safeZonePhase2Dmg)
            globalEntity<GlobalUIManager>.ActivateBorderMovingNotification()
            LogWarning("Safe Zone phase 2: " + safeZoneStartPoints[index] + " to " + endPointPosition<Transform>.Position + " with radius from " + safeZonesEndRadius[index] + " to " + (safeZonesEndRadius[index] - reduceRadiusWhenMoving) + " in duration " + safeZonesShrinkDuration[index])
        } else if phase<Phase>.Index == EPhase.LastSafeZone {
            if currentEndPoint == nil {
                LogError("<GlobalSafeZones.fcg>: Cannot close the final zone without a valid endpoint")
                return
            }
            DisableSafeZone()
            EnableMovingSafeZone(currentEndPoint<Transform>.Position, currentEndPoint<Transform>.Position, safeZonesEndRadius[index] - reduceRadiusWhenMoving, 0, lastSafeZoneDuration, safeZonePhase3Dmg)
            globalEntity<GlobalUIManager>.ActivateBorderShrinkingNotification()
            LogWarning("Safe Zone phase 3: " + currentEndPoint<Transform>.Position + " to " + currentEndPoint<Transform>.Position + " with radius from " + (safeZonesEndRadius[index] - reduceRadiusWhenMoving) + " to " + 0 + " in duration " + lastSafeZoneDuration)
        } else if phase<Phase>.Index == EPhase.SuddenDeath {
            if currentEndPoint == nil {
                LogError("<GlobalSafeZones.fcg>: Cannot activate sudden death without a valid endpoint")
                return
            }
            DisableSafeZone()
            EnableMovingSafeZone(currentEndPoint<Transform>.Position, currentEndPoint<Transform>.Position, 0, 0, 0, safeZoneFinalDmg)
            LogWarning("Safe Zone phase 4: " + currentEndPoint<Transform>.Position + " to " + currentEndPoint<Transform>.Position + " with radius from " + 0 + " to " + 0 + " in duration " + 0)
        }
    }
}
